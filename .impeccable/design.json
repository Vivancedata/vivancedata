  "narrative": {
    "northStar": "The Night Log",
    "overview": "A night log is the record a system leaves behind while nobody is watching: a timestamp, a source, the mess that came in, and the fields something managed to fill. The sheet is a warm near-black under cream ink; the structure is a 1px hairline grid and a dot matrix; the display voice is Instrument Serif at one weight; every machine fact is set in Geist Mono; and the green is spent only where a system actually did something right.\n\nThe scene the dark ground was chosen from is the argument for the whole world: an owner-operator reading on a phone at 9pm, in a truck cab or a shop office after the lights are off. It refuses the AI-consultancy hero and it equally refuses the stark white platform sheet this site used to be.",
    "keyCharacteristics": [
      "Warm near-black sheet under cream ink; dark is canonical, light is its counterpart",
      "Nothing is a card and nothing casts a shadow; depth is a 1px rule",
      "Three faces with three jobs: Instrument Serif display, Geist Sans prose, Geist Mono facts",
      "Green marks affirmative machine state only",
      "Every control is a mono uppercase pill, 44px minimum"
    ],
    "rules": [
      {
        "name": "The Evidence Green Rule",
        "body": "Green means a machine got this right. If you cannot name the machine that verified the thing you just coloured, it is not green.",
        "section": "colors"
      },
      {
        "name": "The Wall-Label Floor Rule",
        "body": "mute is a readable tier and clears 4.5:1 on every surface; faint is for wordless aria-hidden glyphs only.",
        "section": "colors"
      },
      {
        "name": "The Italic Turn Rule",
        "body": "Emphasis is the serif's italic, on one word or phrase, once per band. Bold does not exist here.",
        "section": "typography"
      },
      {
        "name": "The Mono-Is-Machine Rule",
        "body": "Geist Mono is for things a machine produced or an operator types; a human sentence is sans or serif.",
        "section": "typography"
      },
      {
        "name": "The Ramp Rule",
        "body": "Every size is a named preset step; a text-[…] value between steps is a defect.",
        "section": "typography"
      },
      {
        "name": "The Hairline-Only Rule",
        "body": "A panel is bounded by border-rule on all four edges or it is not a panel. No shadow, no lift.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do build structure out of border-rule hairlines and let cells borrow neighbours' edges.",
      "Do spend brand only on affirmative machine state.",
      "Do carry emphasis with the serif's italic, once per band.",
      "Do keep every control at a 44px minimum height.",
      "Do set any readable text in mute or darker; faint is for wordless glyphs."
    ],
    "donts": [
      "Don't put the green on emphasis, prices, headings, icons or links in general.",
      "Don't add a card, a shadow, a hover lift or a rounded panel.",
      "Don't set words in faint, even in an aria-hidden strip.",
      "Don't put an eyebrow or kicker above a heading.",
      "Don't pick a size between the ramp's steps with text-[…]."
    ]
  }
}
