{
  "name": "vivancedata",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start",
    "check:ui-boundary": "vivance-ui-boundary --allow header.tsx,form.tsx",
    "check:build-parity": "node scripts/check-build-parity.mjs",
    "lint": "npm run check:ui-boundary && npm run check:build-parity && eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "react-doctor:score": "npx -y react-doctor@latest . --score",
    "react-doctor:ci": "node scripts/check-react-doctor-score.mjs",
    "lighthouse:ci": "node scripts/check-lighthouse-score.mjs http://127.0.0.1:3000 / /methodology /innovation-hub /case-studies /resources",
    "audit": "npm audit --workspaces=false",
    "audit:json": "npm audit --workspaces=false --json",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run --config vitest.unit.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "test:coverage": "npm run test:unit && npm run test:integration",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true next build",
    "clean": "rm -rf .next node_modules/.cache"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@mdx-js/react": "^3.0.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@sentry/nextjs": "^10.69.0",
    "@tailwindcss/typography": "^0.5.20",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vivancedata/ui": "https://github.com/Vivancedata/ui/archive/refs/tags/v0.4.0.tar.gz",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "critters": "^0.0.25",
    "embla-carousel-react": "^8.1.6",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.476.0",
    "next": "^16.3.0",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "^3.1.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.14.0",
      "minimatch": "^3.1.4"
    },
    "@sentry/node": {
      "minimatch": "^10.2.4"
    },
    "@sentry/bundler-plugin-core": {
      "glob": {
        "minimatch": "^10.2.4"
      }
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    },
    "eslint": {
      "ajv": "^6.14.0",
      "minimatch": "^3.1.4"
    },
    "eslint-plugin-import": {
      "minimatch": "^3.1.4"
    },
    "eslint-plugin-jsx-a11y": {
      "minimatch": "^3.1.4"
    },
    "eslint-plugin-react": {
      "minimatch": "^3.1.4"
    },
    "flatted": "^3.4.0",
    "undici": "^7.24.0",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@next/bundle-analyzer": "16.3.0",
    "@next/eslint-plugin-next": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "typescript-eslint": "^8.66.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
