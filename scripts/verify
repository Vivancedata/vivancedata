#!/usr/bin/env bash
# Fast gate that Claude Code runs before a session can finish: `npm run verify`
# minus the Next.js build and the React Doctor ratchet (it needs its score API).
# The full check before a PR is still `npm run verify` plus `npm run verify:e2e`.
set -euo pipefail
cd "$(dirname "$0")/.."

npm ci
npm run verify:lint
npm run verify:typecheck
npm run verify:unit
npm run verify:integration
